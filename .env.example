# Supabase Configuration
# Get these values from your Supabase project settings
# https://supabase.com/dashboard/

# Supabase uses the new publishable key format (sb_publishable_xxx)
# which replaces the deprecated anon key. Both work the same way.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Note: If these variables are not set, the application will use
# demo data stored locally. This is useful for development and testing.
# When Supabase is connected, data is persisted to the cloud database.
# When Supabase is not available, the app falls back to local demo data.
